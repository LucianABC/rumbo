# Copy to .env and adjust. Everything here is for the local machine only; never commit .env.
# Every variable has a default, so `docker compose up` also works without a .env file.

# --- Docker Compose (docker-compose.yml) ---
# Postgres credentials and database used by every container.
POSTGRES_USER=rumbo
POSTGRES_PASSWORD=rumbo
POSTGRES_DB=rumbo
# Host ports, bound to 127.0.0.1 only. Change them if they clash with something already running.
POSTGRES_PORT=5433
WEB_PORT=3000
# Baked into the api image and reported by GET /api/v1/healthz.
APP_VERSION=dev
GIT_COMMIT=unknown

# --- Host-side tools and `pnpm dev`-style runs outside Docker ---
# Read by packages/db/prisma.config.ts (pnpm db:migrate), apps/api and apps/worker.
DATABASE_URL=postgresql://rumbo:rumbo@127.0.0.1:5433/rumbo
# apps/api listen port.
PORT=3001
# apps/web: where the web server reaches the API (proxy for /api/* and the status page).
API_INTERNAL_URL=http://127.0.0.1:3001
