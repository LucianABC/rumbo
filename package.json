{
  "name": "rumbo",
  "private": true,
  "description": "Multi-agent assistant for a tech job search",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs all",
    "dev:web": "node scripts/dev.mjs web",
    "dev:api": "node scripts/dev.mjs api",
    "dev:worker": "node scripts/dev.mjs worker",
    "build:packages": "pnpm -r --filter \"./packages/**\" --if-present run build",
    "build": "pnpm -r --if-present run build",
    "db:migrate": "pnpm --filter @rumbo/db db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "pnpm build:packages && pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @rumbo/e2e test:e2e",
    "typecheck": "pnpm build:packages && pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
