{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next.js compiles the app itself; tsc only typechecks.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": true,
    "declaration": false,
    "declarationMap": false,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "vitest.config.ts",
    "src",
    "test",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
